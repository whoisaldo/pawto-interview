# Template. Copy to .env and fill in a real password:
#   cp .env.example .env
# .env is gitignored; this file is committed and must never hold real secrets.
#
# docker-compose.yml reads these same variables, so one file configures both
# the database container and the app.

DB_HOST=localhost
DB_PORT=5433
DB_NAME=tandemcode_dev
DB_USER=tandemcode
DB_PASSWORD=

CORS_ORIGINS=http://localhost:5173

# Clerk instance that signs session tokens. Find it in the Clerk dashboard
# under API Keys as the Frontend API URL. Not a secret.
CLERK_ISSUER=https://your-app.clerk.accounts.dev

# Clerk dashboard -> API Keys -> Secret key. Used to read user profiles so
# that email and name never come from the client. This one IS a secret.
CLERK_SECRET_KEY=

# Clerk user ids allowed to run interviews: create sessions, see held-back
# cases and reference answers, and score. Comma-separated. Empty means nobody
# can, and everyone can still be a candidate.
INTERVIEW_OPERATOR_IDS=

RUN_MIGRATIONS_ON_STARTUP=true

# The interview assistant runs a Claude Code CLI that is already installed
# and signed in on this host. All four must be set to turn it on; left empty,
# the assistant is off and says so. See docs/interviews.md.
#   CLAUDE_CLI_COMMAND     absolute path to the CLI or to a launcher for it
#   CLAUDE_CLI_CONFIG_DIR  the profile directory set aside for this service
#   CLAUDE_CLI_MODEL       the one model to ask; nothing is substituted for it
#   CLAUDE_CLI_WORKDIR     an empty directory the CLI is started in
CLAUDE_CLI_COMMAND=
CLAUDE_CLI_CONFIG_DIR=
CLAUDE_CLI_MODEL=
CLAUDE_CLI_WORKDIR=
# Optional: low, medium, high, xhigh or max; and seconds before a run is stopped.
CLAUDE_CLI_EFFORT=
CLAUDE_CLI_TIMEOUT_SECONDS=

# AUTH_MODE=demo replaces Clerk with a local stand-in for a demonstration on
# one machine and its tailnet. It is never for a deployment, it refuses to
# start while the Clerk values above are set, and it needs its own two
# secrets. docs/interviews.md has the steps. Leave this as clerk.
AUTH_MODE=clerk
DEMO_AUTH_SECRET=
DEMO_OPERATOR_CODE=

# Image each submission is judged in. The runner pulls it on start.
SANDBOX_IMAGE=python:3.11-slim
# Container runtime for judging. Production sets runsc (gVisor, installed by
# infra/install-gvisor.sh); empty means Docker's default.
SANDBOX_RUNTIME=

# Only for `docker compose --profile prod up`, which builds the web app too.
# Clerk dashboard -> API Keys -> Publishable key. Not a secret.
VITE_CLERK_PUBLISHABLE_KEY=
# Where browsers reach the API. Baked into the web build.
VITE_BACKEND_URL=http://localhost:8080
